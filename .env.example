# Public host name for HTTPS. Without your own domain, use the VM's public IP
# with nip.io, e.g. 149.165.1.2.nip.io — Caddy obtains a real certificate for it.
DOMAIN=

# Login required on every page. Choose something long.
APP_PASSWORD=
APP_USER=admin

# Set to "true" only on a single-user or trusted instance. It re-enables the
# "Previous Runs" picker, which lists every sample anyone has submitted to this
# server. Leave it blank when hosting publicly.
SHOW_RUN_HISTORY=

# Login auditing. Every login attempt is written to runs/auth-log.jsonl regardless
# of these settings; they only control the emailed summary.
# Get an API key from https://resend.com (free tier). Without a verified sending
# domain, Resend only delivers to the address that owns the account, which is fine
# when you are the only recipient.
RESEND_API_KEY=
ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM=onboarding@resend.dev   # Resend's test sender; override once you verify a domain
# DIGEST_HOUR=8                            # hour (UTC) to send the previous day's digest
# GEOLOCATE=false                          # turn off the ip-api.com city lookup
